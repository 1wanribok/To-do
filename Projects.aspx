<%@ Page Title="Projects" Language="C#" MasterPageFile="~/Site.master" AutoEventWireup="true" CodeFile="Projects.aspx.cs" Inherits="Projects" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
    <h1>Projects</h1>

    <section class="panel">
        <h2>Create a project</h2>
        <div class="form-row">
            <div>
                <label>Name</label>
                <asp:TextBox ID="txtName" runat="server" MaxLength="120" />
                <asp:RequiredFieldValidator runat="server" ControlToValidate="txtName" ValidationGroup="add"
                    ErrorMessage="Enter a project name." CssClass="err" Display="Dynamic" />
            </div>
            <div class="grow">
                <label>Description</label>
                <asp:TextBox ID="txtDesc" runat="server" MaxLength="400" />
            </div>
            <div>
                <label>Due date</label>
                <asp:TextBox ID="txtDue" runat="server" TextMode="Date" />
            </div>
            <div>
                <asp:Button ID="btnAdd" runat="server" Text="Create project" CssClass="btn" ValidationGroup="add" OnClick="btnAdd_Click" />
            </div>
        </div>
    </section>

    <section class="panel">
        <h2>All projects</h2>
        <asp:GridView ID="gvProjects" runat="server" DataSourceID="sdsProjects" DataKeyNames="ProjectId"
            AutoGenerateColumns="False" AutoGenerateEditButton="True" AutoGenerateDeleteButton="True"
            CssClass="grid" GridLines="None" EmptyDataText="No projects yet. Create the first one above.">
            <Columns>
                <asp:BoundField DataField="Name"        HeaderText="Name" />
                <asp:BoundField DataField="Description" HeaderText="Description" />
                <asp:BoundField DataField="DueDate"     HeaderText="Due date" DataFormatString="{0:yyyy-MM-dd}" ApplyFormatInEditMode="True" />
                <asp:BoundField DataField="DoneTasks"   HeaderText="Done"  ReadOnly="True" />
                <asp:BoundField DataField="TotalTasks"  HeaderText="Total" ReadOnly="True" />
            </Columns>
        </asp:GridView>
        <p class="hint">Deleting a project also deletes its tasks.</p>
        <asp:SqlDataSource ID="sdsProjects" runat="server"
            ConnectionString="<%$ ConnectionStrings:TeamBoardDB %>"
            SelectCommand="SELECT p.ProjectId, p.Name, p.Description, p.DueDate,
                             (SELECT COUNT(*) FROM Tasks t WHERE t.ProjectId = p.ProjectId AND t.Status = 'Done') AS DoneTasks,
                             (SELECT COUNT(*) FROM Tasks t WHERE t.ProjectId = p.ProjectId) AS TotalTasks
                           FROM Projects p ORDER BY p.Name"
            InsertCommand="INSERT INTO Projects (Name, Description, DueDate) VALUES (@Name, @Description, @DueDate)"
            UpdateCommand="UPDATE Projects SET Name=@Name, Description=@Description, DueDate=@DueDate WHERE ProjectId=@ProjectId"
            DeleteCommand="DELETE FROM Projects WHERE ProjectId=@ProjectId">
            <InsertParameters>
                <asp:ControlParameter Name="Name"        ControlID="txtName" PropertyName="Text" />
                <asp:ControlParameter Name="Description" ControlID="txtDesc" PropertyName="Text" />
                <asp:ControlParameter Name="DueDate"     ControlID="txtDue"  PropertyName="Text" Type="DateTime" />
            </InsertParameters>
            <UpdateParameters>
                <asp:Parameter Name="Name" />
                <asp:Parameter Name="Description" />
                <asp:Parameter Name="DueDate" Type="DateTime" />
                <asp:Parameter Name="ProjectId" Type="Int32" />
            </UpdateParameters>
        </asp:SqlDataSource>
    </section>
</asp:Content>
