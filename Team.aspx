<%@ Page Title="Team" Language="C#" MasterPageFile="~/Site.master" AutoEventWireup="true" CodeFile="Team.aspx.cs" Inherits="Team" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
    <h1>Team</h1>

    <section class="panel">
        <h2>Add a member</h2>
        <div class="form-row">
            <div>
                <label>Full name</label>
                <asp:TextBox ID="txtName" runat="server" MaxLength="100" />
                <asp:RequiredFieldValidator runat="server" ControlToValidate="txtName" ValidationGroup="add"
                    ErrorMessage="Enter a name." CssClass="err" Display="Dynamic" />
            </div>
            <div>
                <label>Email</label>
                <asp:TextBox ID="txtEmail" runat="server" MaxLength="150" />
                <asp:RegularExpressionValidator runat="server" ControlToValidate="txtEmail" ValidationGroup="add"
                    ValidationExpression="^[^@\s]+@[^@\s]+\.[^@\s]+$" ErrorMessage="Enter a valid email." CssClass="err" Display="Dynamic" />
                <asp:RequiredFieldValidator runat="server" ControlToValidate="txtEmail" ValidationGroup="add"
                    ErrorMessage="Enter an email." CssClass="err" Display="Dynamic" />
            </div>
            <div>
                <label>Role</label>
                <asp:DropDownList ID="ddlRole" runat="server">
                    <asp:ListItem>Developer</asp:ListItem>
                    <asp:ListItem>Designer</asp:ListItem>
                    <asp:ListItem>Tester</asp:ListItem>
                    <asp:ListItem>Manager</asp:ListItem>
                </asp:DropDownList>
            </div>
            <div>
                <asp:Button ID="btnAdd" runat="server" Text="Add member" CssClass="btn" ValidationGroup="add" OnClick="btnAdd_Click" />
            </div>
        </div>
    </section>

    <section class="panel">
        <h2>All members</h2>
        <asp:GridView ID="gvMembers" runat="server" DataSourceID="sdsMembers" DataKeyNames="MemberId"
            AutoGenerateColumns="False" AutoGenerateEditButton="True" AutoGenerateDeleteButton="True"
            CssClass="grid" GridLines="None" EmptyDataText="No members yet. Add the first one above.">
            <Columns>
                <asp:BoundField DataField="FullName" HeaderText="Name" />
                <asp:BoundField DataField="Email"    HeaderText="Email" />
                <asp:BoundField DataField="Role"     HeaderText="Role" />
            </Columns>
        </asp:GridView>
        <asp:SqlDataSource ID="sdsMembers" runat="server"
            ConnectionString="<%$ ConnectionStrings:TeamBoardDB %>"
            SelectCommand="SELECT MemberId, FullName, Email, Role FROM Members ORDER BY FullName"
            InsertCommand="INSERT INTO Members (FullName, Email, Role) VALUES (@FullName, @Email, @Role)"
            UpdateCommand="UPDATE Members SET FullName=@FullName, Email=@Email, Role=@Role WHERE MemberId=@MemberId"
            DeleteCommand="DELETE FROM Members WHERE MemberId=@MemberId">
            <InsertParameters>
                <asp:ControlParameter Name="FullName" ControlID="txtName"  PropertyName="Text" />
                <asp:ControlParameter Name="Email"    ControlID="txtEmail" PropertyName="Text" />
                <asp:ControlParameter Name="Role"     ControlID="ddlRole"  PropertyName="SelectedValue" />
            </InsertParameters>
        </asp:SqlDataSource>
    </section>
</asp:Content>
